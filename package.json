{
  "name": "zoom-meeting-timer",
  "version": "1.0.0",
  "description": "A Zoom App that tracks live meeting time from inside the Zoom client",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint:security": "eslint --max-warnings 0 server.js eslint.config.js \"public/**/*.js\"",
    "audit": "npm audit",
    "security-check": "npm run lint:security && npm audit"
  },
  "dependencies": {
    "@zoom/appssdk": "0.16.42",
    "axios": "^1.7.2",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1"
  }
}
